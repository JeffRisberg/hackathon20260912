# Copy this file to .env and fill in values as needed.

# Port used for communication between agent_red and agent_blue
AGENT_COMM_PORT=8765

# Model identifier for pydantic-ai, e.g. openai:gpt-4o-mini or anthropic:claude-sonnet-5
PYDANTIC_AI_MODEL=

# Enable observability/tracing instrumentation (true/false)
OBSERVABILITY_ENABLED=false

# API key for the selected model provider (only one is typically needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

