# Copy this file to .env and fill in values as needed.
# Prefer the repo-root .env for W&B Inference / Weave settings.

# Port used for communication between agent_red and agent_blue
AGENT_COMM_PORT=8765

# Port used for communication from agent_red to the frontend dev server
# (separate from AGENT_COMM_PORT so the two UDP listeners don't collide)
FRONTEND_COMM_PORT=8766

# Port the agent_red FastAPI server listens on
RED_AGENT_PORT=8000

# Enable observability/tracing instrumentation (true/false)
OBSERVABILITY_ENABLED=false
